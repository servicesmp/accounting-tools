{
  "name": "accounting-tools",
  "version": "1.1.0",
  "description": "Unified Factur-X/ZUGFeRD invoice generation, PDF templates & compliance library. Single-package install.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "jest --config packages/core/jest.config.js",
    "build:packages": "cd packages/core && npm run build && cd ../templates && npm run build"
  },
  "keywords": [
    "factur-x",
    "zugferd",
    "en16931",
    "electronic-invoice",
    "e-invoicing",
    "xml",
    "pdf",
    "pdf-a3",
    "cii",
    "french-invoice",
    "xp-z12-012"
  ],
  "author": "SMP Solutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/servicesmp/accounting-tools"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.8.10",
    "big.js": "^6.2.1",
    "fast-xml-parser": "^4.3.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.6",
    "@types/qrcode": "^1.5.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
